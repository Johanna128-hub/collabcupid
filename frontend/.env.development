# Local development: point the app at the Firebase Local Emulator Suite
# instead of a real Firebase project. Run `npm run emulators` (see
# README-FIREBASE.md) alongside `npm run dev` for a fully offline setup.
VITE_USE_FIREBASE_EMULATOR=true
VITE_EMULATOR_HOST=localhost

# These can be left as-is for emulator use (the emulators don't check
# them) -- fill in real values from your Firebase project's config once
# you're ready to run against the real cloud project (see
# .env.production.example).
VITE_FIREBASE_API_KEY=demo-api-key
VITE_FIREBASE_AUTH_DOMAIN=demo-collabcupid.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=demo-collabcupid
VITE_FIREBASE_STORAGE_BUCKET=demo-collabcupid.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:0000000000000000000000
