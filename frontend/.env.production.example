# Copy to .env.production.local (or set these in your hosting
# environment) once you've created a real Firebase project -- see
# README-FIREBASE.md for exactly where to find each value in the
# Firebase console (Project Settings -> General -> Your apps -> SDK
# setup and configuration).

VITE_USE_FIREBASE_EMULATOR=false

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
